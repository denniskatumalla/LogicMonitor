# /etc/shortlink/shortlink.env  (mode 0640, root:shortlink)
# cloud-init writes this file with real values; this copy documents each one.

# Public listener: API, redirects, /health.
SHORTLINK_BIND=0.0.0.0
SHORTLINK_PORT=8080
# Base for shortUrl in responses. Empty = taken from the request's Host header.
SHORTLINK_BASE_URL=

# Admin listener (/admin/chaos). Loopback only; disabled if the token is empty.
SHORTLINK_ADMIN_BIND=127.0.0.1
SHORTLINK_ADMIN_PORT=8081
SHORTLINK_ADMIN_TOKEN=change-me

# HTTPS twin of the public listener. Enabled when a keystore is set.
SHORTLINK_TLS_PORT=8443
SHORTLINK_TLS_KEYSTORE=/etc/shortlink/tls.p12
SHORTLINK_TLS_PASSWORD=change-me

SHORTLINK_DATA_DIR=/var/lib/shortlink

# Health rules and fault injection (defaults shown).
SHORTLINK_DEGRADED_P95_MS=500
SHORTLINK_DEGRADED_ERROR_PERCENT=5
SHORTLINK_WINDOW_SECONDS=60
SHORTLINK_CHAOS_LATENCY_MS=1500
SHORTLINK_CHAOS_ERROR_PERCENT=50

JAVA_OPTS="-Xms128m -Xmx256m -XX:+ExitOnOutOfMemoryError"

# Remote JMX for the LogicMonitor collector on a fixed port (RMI on the same
# port, so one port to reason about). Bound to the VM's private IP, which is
# what the collector connects to (##HOSTNAME##); the security group never
# opens 9010, so only processes on this VM can reach it. Unauthenticated by
# design for the demo: see docs/DOCUMENTATION.md for the password-file variant.
JMX_OPTS="-Dcom.sun.management.jmxremote.port=9010 -Dcom.sun.management.jmxremote.rmi.port=9010 -Dcom.sun.management.jmxremote.host=10.0.0.10 -Djava.rmi.server.hostname=10.0.0.10 -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.ssl=false"
