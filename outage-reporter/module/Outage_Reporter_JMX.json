{
  "_comment": "Spec for a JMX DataSource reading the app's own MBean, built by hand in the portal. Graph-only on purpose: alerting lives in Outage_Reporter_Health, so one fault raises one alert. JVM internals (heap, GC, threads) come from LogicMonitor's built-in JVM modules via the same jmx.port.",
  "name": "Outage_Reporter_JMX",
  "displayName": "Outage Reporter JMX",
  "description": "In-process counters and business figures from the outagereporter:type=Stats MBean over remote JMX.",
  "group": "Outage Reporter",
  "appliesTo": "outage.port =~ \"^[0-9]+$\" && jmx.port =~ \"^[0-9]+$\"",
  "multiInstance": false,
  "collectIntervalSeconds": 60,
  "collection": {
    "method": "jmx",
    "url": "service:jmx:rmi:///jndi/rmi://##HOSTNAME##:##jmx.port##/jmxrmi"
  },
  "datapoints": [
    { "name": "StatusCode",              "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "StatusCode",              "description": "0 = UP, 1 = DEGRADED, 2 = DOWN" },
    { "name": "UptimeSeconds",           "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "UptimeSeconds" },
    { "name": "Tickets",                 "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "Tickets",                 "description": "Tickets in the store, restored ones included" },
    { "name": "RequestRate",             "type": "derive", "minValue": 0, "objectName": "outagereporter:type=Stats", "attribute": "RequestsTotal" },
    { "name": "ServerErrorRate",         "type": "derive", "minValue": 0, "objectName": "outagereporter:type=Stats", "attribute": "ErrorsTotal" },
    { "name": "ClientErrorRate",         "type": "derive", "minValue": 0, "objectName": "outagereporter:type=Stats", "attribute": "ClientErrorsTotal" },
    { "name": "ReportRate",              "type": "derive", "minValue": 0, "objectName": "outagereporter:type=Stats", "attribute": "ReportsTotal",            "description": "Customer reports per second" },
    { "name": "P95LatencyMs",            "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "P95LatencyMs" },
    { "name": "ErrorRatePct",            "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "ErrorRatePct" },
    { "name": "StoreOk",                 "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "StoreOk",                 "description": "1 = writable, 0 = not" },
    { "name": "ChaosModeCode",           "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "ChaosModeCode",           "description": "0 off, 1 latency, 2 errors, 3 store, 4 storm" },
    { "name": "ReportsLastMinute",       "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "ReportsLastMinute" },
    { "name": "FailedReportsLastMinute", "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "FailedReportsLastMinute" },
    { "name": "OpenOutages",             "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "OpenOutages" },
    { "name": "CustomersAffected",       "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "CustomersAffected" },
    { "name": "AwaitingTriage",          "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "AwaitingTriage" },
    { "name": "OldestOpenMinutes",       "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "OldestOpenMinutes" },
    { "name": "OverdueOutages",          "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "OverdueOutages" },
    { "name": "StormMode",               "type": "gauge",  "objectName": "outagereporter:type=Stats", "attribute": "StormMode",               "description": "1 = storm response in effect" }
  ]
}
