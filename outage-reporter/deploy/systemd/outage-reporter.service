[Unit]
Description=Outage Reporter (Example Power & Light demo)
After=network-online.target
Wants=network-online.target
# Installed by cloud-init before the jar is copied up; start once it is there.
ConditionPathExists=/opt/outage-reporter/outage-reporter.jar

[Service]
Type=simple
User=outage
Group=outage
# Written by cloud-init: ports, secrets, JAVA_OPTS (heap, request timeouts) and JMX_OPTS.
EnvironmentFile=/etc/outage-reporter/outage-reporter.env
# $JAVA_OPTS and $JMX_OPTS unbraced, so systemd splits them into separate arguments.
ExecStart=/usr/bin/java $JAVA_OPTS $JMX_OPTS -jar /opt/outage-reporter/outage-reporter.jar
# The JVM exits 143 after running its shutdown hooks on SIGTERM; that is a clean stop.
SuccessExitStatus=143
# Crashes (and kill -9) come back on their own; `systemctl stop` stays stopped.
Restart=on-failure
RestartSec=5
# SIGKILL if shutdown takes longer than 15 s.
TimeoutStopSec=15
SyslogIdentifier=outage-reporter

# Sandbox: filesystem read-only except /var/lib/outage-reporter (StateDirectory)
# and a private /tmp; no privilege escalation, home dirs hidden, kernel tunables
# and cgroups read-only.
StateDirectory=outage-reporter
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
