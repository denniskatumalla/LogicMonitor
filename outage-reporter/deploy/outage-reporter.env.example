# /etc/outage-reporter/outage-reporter.env  (mode 0640, root:outage)
# cloud-init writes this file with real values; this copy documents each one.

# Public listener: customer pages, JSON API, form POST, /health.
OUTAGE_BIND=0.0.0.0
OUTAGE_PORT=8080

# Admin listener (/admin/chaos). Loopback only; disabled if the token is empty.
OUTAGE_ADMIN_BIND=127.0.0.1
OUTAGE_ADMIN_PORT=8081
OUTAGE_ADMIN_TOKEN=change-me

# HTTPS twin of the public listener. Enabled when a keystore is set.
OUTAGE_TLS_PORT=8443
OUTAGE_TLS_KEYSTORE=/etc/outage-reporter/tls.p12
OUTAGE_TLS_PASSWORD=change-me

OUTAGE_DATA_DIR=/var/lib/outage-reporter

# Health rules and technical fault injection (defaults shown).
OUTAGE_DEGRADED_P95_MS=500
OUTAGE_DEGRADED_ERROR_PERCENT=5
OUTAGE_WINDOW_SECONDS=60
OUTAGE_CHAOS_LATENCY_MS=1500
OUTAGE_CHAOS_ERROR_PERCENT=50

# The outage model (defaults shown). Restoration is compressed from hours to
# minutes so a ticket's whole life fits in a demo.
OUTAGE_RESTORE_MINUTES=8              # typical time from confirmation to restoration
OUTAGE_TRIAGE_PER_MINUTE=180          # reports the dispatcher can confirm per minute
OUTAGE_TRIAGE_DELAY_SECONDS=10        # a report waits at least this long before confirmation
OUTAGE_DISPATCH_INTERVAL_MS=1000

# Storm surge (chaos storm) and storm response (defaults shown).
OUTAGE_STORM_REPORTS_PER_SECOND=6     # peak surge rate
OUTAGE_STORM_RAMP_SECONDS=10          # time to reach the peak
OUTAGE_STORM_THRESHOLD_PER_MINUTE=60  # reports a minute that declare storm response

JAVA_OPTS="-Xms128m -Xmx256m -XX:+ExitOnOutOfMemoryError"

# Remote JMX for the LogicMonitor collector on a fixed port (RMI on the same
# port, so one port to reason about). Bound to the VM's private IP, which is
# what the collector connects to (##HOSTNAME##); the security group never
# opens 9010, so only processes on this VM can reach it. Unauthenticated by
# design for the demo: see docs/DOCUMENTATION.md for the password-file variant.
JMX_OPTS="-Dcom.sun.management.jmxremote.port=9010 -Dcom.sun.management.jmxremote.rmi.port=9010 -Dcom.sun.management.jmxremote.host=10.0.0.10 -Djava.rmi.server.hostname=10.0.0.10 -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.ssl=false"
