# .env.override for the OpenTelemetry Demo + LogicMonitor
#
#   cp .env.override.example .env.override && chmod 600 .env.override && $EDITOR .env.override
#
# setup.sh copies this file to opentelemetry-demo/.env.override. The demo's Makefile and
# compose command load it with `--env-file .env --env-file .env.override`.
# Never commit the filled-in copy (.gitignore excludes it).

# ---------------------------------------------------------------------------
# Pin the demo images. The 3.1.0 tag's .env still says IMAGE_VERSION=3.0.0 and
# DEMO_VERSION=latest, so without these lines you would pull whatever "latest" is that day.
# ---------------------------------------------------------------------------
DEMO_VERSION=3.1.0
IMAGE_VERSION=3.1.0

# ---------------------------------------------------------------------------
# LogicMonitor portal: the part before .logicmonitor.com (e.g. "acme" for acme.logicmonitor.com)
# ---------------------------------------------------------------------------
LOGICMONITOR_ACCOUNT=yourportal

# Option A (recommended): LMv1 API token from an API-only user.
#   Settings > Users & Roles > Users > add API-only user, with a role that can ingest
#   traces and logs. Then API Tokens > add an LMv1 token. The SDK uses LMv1 first if both are set.
LOGICMONITOR_ACCESS_ID=
LOGICMONITOR_ACCESS_KEY=

# Option B: Bearer token (Settings > Users & Roles > API Tokens > Bearer).
#   IMPORTANT: include the literal "Bearer " prefix and keep the double quotes.
#   The SDK puts this value into the Authorization header exactly as written.
#   Also required for the experimental --with-otlp-metrics path.
#LOGICMONITOR_BEARER_TOKEN="Bearer lmb_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Resource mapping. This value is stamped as host.name on every span and log.
# Make it match the system.hostname of the VM's resource in LM: add the VM to LM
# by the same name, e.g. the EC2 private DNS name ip-172-31-x-y.ec2.internal.
# setup.sh fills it with `hostname -f` if you leave it empty.
# ---------------------------------------------------------------------------
LM_HOST_NAME=
LM_DEPLOYMENT_ENV=cta-demo

# ---------------------------------------------------------------------------
# Browser (frontend-web) spans. The browser posts its spans to this URL, so for remote
# viewers it must be the VM's public address, not localhost. setup.sh fills it from EC2 metadata.
# ---------------------------------------------------------------------------
#PUBLIC_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://<EC2_PUBLIC_IP>:8080/otlp-http/v1/traces

# ---------------------------------------------------------------------------
# Load. Upstream default is 5 Locust users (the load-generator has a 1.5 GB limit and
# includes Playwright browser users). Fewer users = fewer spans billed in LM.
# You can also change users live in the Locust UI at :8080/loadgen/.
# ---------------------------------------------------------------------------
#LOCUST_USERS=5
